# Copiá este archivo como .env y ajustá los valores.

NODE_ENV=development
PORT=3000

# PostgreSQL del docker-compose.yml (puerto 5433 para no chocar con un Postgres local)
DATABASE_URL="postgresql://luminance:luminance@localhost:5433/luminance"

# Orígenes permitidos por CORS (separados por coma)
FRONTEND_URL=http://localhost:5173

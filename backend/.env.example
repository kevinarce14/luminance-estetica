# Copiá este archivo como .env y ajustá los valores.

NODE_ENV=development
PORT=3000

# PostgreSQL del docker-compose.yml (puerto 5433 para no chocar con un Postgres local)
DATABASE_URL="postgresql://luminance:luminance@localhost:5433/luminance"

# Orígenes permitidos por CORS (separados por coma)
FRONTEND_URL=http://localhost:5173

# ===== Autenticación (JWT HS256) =====
# En producción: una clave larga y aleatoria. Cambiarla invalida las sesiones abiertas.
# Generar uno nuevo con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SECRET_KEY=solo-para-desarrollo-cambiar-en-produccion
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Login con Google (vacío = deshabilitado)
GOOGLE_CLIENT_ID=

# ===== Email (Mailjet). Vacío = no se envían; en desarrollo el link de recuperación sale por consola =====
MAILJET_API_KEY_PUBLIC=
MAILJET_API_KEY_PRIVATE=
FROM_EMAIL=noreply@luminancestudio.com
FROM_NAME=Luminance Studio by Cande

# ===== Admin inicial que crea `npm run db:seed` =====
INITIAL_ADMIN_EMAIL=admin@luminancestudio.com
INITIAL_ADMIN_PASSWORD=ChangeThisPassword123!
INITIAL_ADMIN_NAME=Admin

# ===== Reglas de reserva (mismos valores que el legado) =====
TIMEZONE=America/Argentina/Buenos_Aires
MIN_APPOINTMENT_DURATION=30
MIN_BOOKING_ADVANCE_HOURS=2
MAX_BOOKING_ADVANCE_DAYS=30

# ===== MercadoPago (vacío = pago online deshabilitado) =====
# Access Token de prueba (TEST-...) o de producción (APP_USR-...)
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta de Webhooks (panel de MercadoPago → Webhooks). Si está, se valida la firma.
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_API_URL=https://api.mercadopago.com
# URL pública HTTPS de esta API para recibir notificaciones (vacío en local: MercadoPago no puede llegar a localhost)
BACKEND_URL=
